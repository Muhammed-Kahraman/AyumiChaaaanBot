TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Instagram cookie'leri — tarayıcıda instagram.com'a giriş yaptıktan sonra
# F12 → Application → Cookies → https://www.instagram.com adımlarıyla alınır.
# sessionid tek başına yetmiyor; Instagram diğerlerini de bekliyor.
IG_SESSIONID=your_instagram_sessionid_here
IG_CSRFTOKEN=your_instagram_csrftoken_here
IG_DS_USER_ID=your_instagram_ds_user_id_here
IG_MID=your_instagram_mid_here
IG_DID=your_instagram_ig_did_here
IG_DATR=your_instagram_datr_here

# X (Twitter) cookie'leri — X guest token erişimini kapattığı için resim
# tweetlerinde giriş şart. F12 → Application → Cookies → https://x.com
X_AUTH_TOKEN=your_x_auth_token_here
X_CT0=your_x_ct0_here
X_TWID=your_x_twid_here
X_GUEST_ID=your_x_guest_id_here

# AI spoiler tespiti — anahtar tanımlandıktan sonra true yapın.
AI_SPOILER_ENABLED=false
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=none
SPOILER_THRESHOLD=3
SPOILER_MIN_CONFIDENCE=0.65
# AI/FFmpeg başarısızsa medya yine gönderilir. spoiler | normal
AI_FAILURE_POLICY=spoiler

AI_MAX_FRAMES=12
AI_FRAME_MAX_DIMENSION=960
# FFmpeg JPEG qscale: 2 en kaliteli, 31 en düşük kalite.
AI_FRAME_JPEG_QUALITY=5
AI_MAX_VIDEO_DURATION_SECONDS=900
AI_AUDIO_BITRATE_KBPS=40
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
AI_JOB_CONCURRENCY=2
MEDIA_QUEUE_CAPACITY=50
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
